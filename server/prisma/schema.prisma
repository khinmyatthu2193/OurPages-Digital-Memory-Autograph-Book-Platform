generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  bio          String?  @db.VarChar(500)
  avatarUrl    String?  @db.VarChar(2048)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memories     Memory[]

  @@map("users")
}

model Memory {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  authorName  String?  @db.VarChar(100)
  message     String   @db.VarChar(5000)
  isAnonymous Boolean  @default(false)
  promptId    String?  @db.Uuid
  photoUrl    String?  @db.VarChar(2048)
  isFavorite  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prompt      Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, isHidden, createdAt(sort: Desc)])
  @@index([promptId])
  @@map("memories")
}

model Prompt {
  id        String   @id @default(uuid()) @db.Uuid
  text      String   @db.VarChar(300)
  category  String   @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  memories  Memory[]

  @@index([isActive, category])
  @@map("prompts")
}
