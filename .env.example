# Client-safe Vite variables (copy these to client/.env.local)
# The anon key is intentionally public and remains constrained by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Express server variables (copy these to server/.env)
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key

# Server-only. Never prefix this with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
